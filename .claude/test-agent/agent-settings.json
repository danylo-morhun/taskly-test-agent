{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Skill",
      "TodoWrite",
      "Bash(node .claude/skills/test-impact-analysis/scripts/detect-changes.mjs *)",
      "Bash(node .claude/skills/test-verification/scripts/run-tests.mjs *)",
      "Bash(node .claude/skills/test-verification/scripts/patch-coverage.mjs *)",
      "Bash(node .claude/skills/test-verification/scripts/mutation-test.mjs *)",
      "Bash(node .claude/skills/test-verification/scripts/check-test-policy.mjs *)",
      "Bash(node .claude/skills/test-verification/scripts/check-test-policy.mjs)",
      "Bash(node .claude/skills/test-verification/scripts/verify.mjs *)",
      "Bash(node .claude/skills/test-report/scripts/render-report.mjs *)",
      "Bash(node .claude/skills/test-report/scripts/validate-report.mjs *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)"
    ],
    "deny": ["WebFetch", "WebSearch", "NotebookEdit", "Agent"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-test-paths.mjs\"" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"" }]
      }
    ]
  }
}
